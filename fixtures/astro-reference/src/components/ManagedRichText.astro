---
import type { ManagedRichTextMark } from "@landing-pages-websites/managed-site-contract";

import type { ManagedAstroRichText } from "../lib/managed-site";

interface Props {
  readonly document: ManagedAstroRichText;
}

const { document } = Astro.props;

/**
 * Marks are objects, so a kind is matched rather than compared. A link mark
 * carries a destination this reference site does not resolve yet; its text still
 * renders, which is more than the previous renderer managed with a link node.
 */
function has(
  marks: readonly ManagedRichTextMark[] | undefined,
  kind: ManagedRichTextMark["type"],
): boolean {
  // Unmarked text omits the key, so absent and empty mean the same thing here.
  return (marks ?? []).some((mark) => mark.type === kind);
}
---

<div class="managed-rich-text">
  {
    document.content.map((block) => {
      if (block.type === "paragraph") {
        return (
          <p>
            {block.content.map((text) => (
              <span
                class:list={{
                  "managed-rich-text__bold": has(text.marks, "bold"),
                  "managed-rich-text__italic": has(text.marks, "italic"),
                }}
              >
                {text.text}
              </span>
            ))}
          </p>
        );
      }
      const List = block.type === "ordered_list" ? "ol" : "ul";
      return (
        <List>
          {block.content.map((item) => (
            <li>
              {item.content.map((paragraph) => (
                <p>
                  {paragraph.content.map((text) => (
                    <span
                      class:list={{
                        "managed-rich-text__bold": has(text.marks, "bold"),
                        "managed-rich-text__italic": has(text.marks, "italic"),
                      }}
                    >
                      {text.text}
                    </span>
                  ))}
                </p>
              ))}
            </li>
          ))}
        </List>
      );
    })
  }
</div>
